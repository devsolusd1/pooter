{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/variants/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path((?!api(?:/|$)|\\.well-known(?:/|$))(?:[^/]+/)*[^/.]+)",
      "destination": "/:path*/",
      "permanent": true
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/metadata.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
